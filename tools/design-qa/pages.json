{
  "_note": "route uses {lang}. Update routes if localized slugs are chosen (e.g. /nl/prijzen). 'states' are scripted interactions matched by visible text (first visible match unless nth is given, 0-based; 're:' prefix = regex), so they run the same on design and build.",
  "home": {
    "design": "VangAI Home.dc.html",
    "route": "/{lang}",
    "states": [
      {
        "name": "nav-product-dropdown",
        "vp": ["desktop"],
        "steps": [
          {
            "hover": "re:^Product"
          }
        ]
      },
      {
        "name": "demo-tab-message",
        "steps": [
          {
            "click": "VangMessage"
          }
        ]
      },
      {
        "name": "demo-tab-chat",
        "steps": [
          {
            "click": "VangChat"
          }
        ]
      },
      {
        "name": "included-reveal-all",
        "steps": [
          {
            "click": "Reveal all"
          }
        ]
      },
      {
        "name": "faq-first-open",
        "steps": [
          {
            "click": "Is this a chatbot with a script?"
          }
        ]
      },
      {
        "name": "faq-show-more",
        "steps": [
          {
            "click": "Show more questions"
          }
        ]
      },
      {
        "name": "whatsapp-demo-answer",
        "steps": [
          {
            "click": "VangMessage"
          },
          {
            "click": "What does a basic service cost?"
          },
          {
            "wait": 1600
          }
        ]
      },
      {
        "name": "webchat-demo-answer",
        "steps": [
          {
            "click": "VangChat"
          },
          {
            "click": "What does a basic service cost?"
          },
          {
            "wait": 1600
          }
        ]
      }
    ]
  },
