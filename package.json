{
  "name": "vangai-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "i18n:dictionary": "node scripts/build-design-dictionary.mjs",
    "i18n:sync": "node scripts/sync-translations.mjs",
    "i18n:check": "node scripts/sync-translations.mjs --check",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run i18n:check && vitest run && npm run build"
  },
  "dependencies": {
    "motion": "^13.4.3",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.29.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
