# Contact form email (https://resend.com). Server-only, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Optional. Public base URL for share images, canonical links and the sitemap. On Vercel it
# defaults to the project's production domain; set it only to force another address.
NEXT_PUBLIC_SITE_URL=

# Retell public key for the live voice agent ("Call the assistant"). Public by design: Retell
# only accepts it from the allowed domains you set on the key. Empty: the scripted demo runs.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=
